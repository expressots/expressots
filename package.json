{
  "name": "expressots-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "ExpressoTS — modern, fast, lightweight Node.js web framework (monorepo)",
  "author": "Richard Zampieri",
  "license": "MIT",
  "homepage": "https://expresso-ts.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/expressots/expressots"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "packageManager": "pnpm@10.14.0",
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "format": "turbo run format",
    "changeset": "changeset",
    "release": "node scripts/release/index.mjs",
    "prepare": "husky",
    "release:report": "node scripts/release/index.mjs --report-only"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.0",
    "@changesets/cli": "^2.27.0",
    "@commitlint/cli": "^19.5.0",
    "@commitlint/config-conventional": "^19.5.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.2.10",
    "prettier": "^3.3.0",
    "publint": "^0.3.0",
    "turbo": "^2.10.7"
  },
  "lint-staged": {
    "*.{ts,tsx,json,md,yml,yaml}": [
      "prettier --write --cache"
    ]
  }
}
