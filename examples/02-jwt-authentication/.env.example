APP_NAME=expressots-example
PORT=3000
NODE_ENV=development
LOG_LEVEL=INFO
JWT_ALGORITHM=HS256
JWT_ISSUER=expressots-example-02
JWT_AUDIENCE=expressots-example-api
# Generate locally: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
JWT_SECRET=
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=604800
JWT_SESSION_TTL_SECONDS=2592000
