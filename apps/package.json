{
  "name": "@expressots/studio-monorepo",
  "version": "4.0.0",
  "private": true,
  "type": "module",
  "description": "ExpressoTS Studio - Developer Experience Platform",
  "author": "Richard Zampieri",
  "license": "MIT",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "build:agent": "npm run build -w @expressots/studio-agent",
    "build:studio": "npm run build -w @expressots/studio",
    "build:mcp": "npm run build -w @expressots/mcp-server",
    "dev": "npm run dev -w @expressots/studio",
    "dev:ui": "npm run dev:ui -w @expressots/studio",
    "lint": "eslint \"packages/**/*.ts\" \"packages/**/*.tsx\" --cache --cache-location node_modules/.cache/eslint/",
    "lint:fix": "eslint \"packages/**/*.ts\" \"packages/**/*.tsx\" --fix --cache --cache-location node_modules/.cache/eslint/",
    "format": "prettier --write \"packages/**/*.{ts,tsx,json}\" --cache",
    "test": "npm run test --workspaces",
    "clean": "node scripts/clean.js",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.5.0",
    "@commitlint/config-conventional": "^19.5.0",
    "@types/node": "^22.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "husky": "^9.1.7",
    "prettier": "^3.3.0",
    "typescript": "^5.5.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/expressots/expressots-studio"
  },
  "homepage": "https://studio.expressots.com",
  "bugs": {
    "url": "https://github.com/expressots/expressots-studio/issues"
  }
}
