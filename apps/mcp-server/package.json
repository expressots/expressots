{
  "name": "@expressots/mcp-server",
  "version": "4.0.0",
  "private": true,
  "publishConfig": {
    "access": "public"
  },
  "description": "MCP Server for ExpressoTS Studio - AI-powered code generation and optimization tools (NOT YET PUBLISHED — coming in a later preview)",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "bin": {
    "expressots-mcp": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/cli.js",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "glob": "^11.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "rimraf": "^6.0.0",
    "typescript": "^5.6.0",
    "vite": "^6.4.3",
    "vitest": "^4.1.7"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/expressots/expressots.git",
    "directory": "apps/mcp-server"
  },
  "keywords": [
    "expressots",
    "mcp",
    "ai",
    "code-generation",
    "model-context-protocol"
  ],
  "author": "ExpressoTS Team",
  "license": "MIT",
  "engines": {
    "node": ">=20.19.0"
  }
}
