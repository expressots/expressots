{
  "name": "@expressots/studio-agent",
  "version": "4.0.0-preview.3.4",
  "publishConfig": {
    "access": "public"
  },
  "description": "Instrumentation agent for ExpressoTS Studio - route discovery, tracing, and request recording",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rimraf dist",
    "release:prepare": "node scripts/release/prepare-publish.mjs",
    "release:restore": "node scripts/release/restore-package-json.mjs",
    "release:publish": "npm run build && npm run release:prepare && npm publish --tag next --access public && npm run release:restore"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.76.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.218.0",
    "@opentelemetry/instrumentation-express": "^0.66.0",
    "@opentelemetry/instrumentation-http": "^0.218.0",
    "@opentelemetry/resources": "^2.7.1",
    "@opentelemetry/sdk-node": "^0.218.0",
    "@opentelemetry/sdk-trace-node": "^2.7.1",
    "@opentelemetry/semantic-conventions": "^1.41.1",
    "glob": "^13.0.0",
    "socket.io": "^4.8.0",
    "socket.io-client": "^4.8.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "rimraf": "^6.0.0",
    "typescript": "^5.5.0",
    "vite": "^6.4.3",
    "vitest": "^4.1.7"
  },
  "peerDependencies": {
    "@expressots/core": ">=4.0.0-0"
  },
  "peerDependenciesMeta": {
    "@expressots/core": {
      "optional": true
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/expressots/expressots-studio",
    "directory": "packages/studio-agent"
  },
  "keywords": [
    "expressots",
    "studio",
    "instrumentation",
    "tracing",
    "opentelemetry",
    "observability"
  ],
  "author": "ExpressoTS Team",
  "license": "MIT"
}
