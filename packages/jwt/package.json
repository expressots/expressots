{
  "name": "@expressots/jwt",
  "version": "4.3.0",
  "description": "ExpressoTS JWT provider, refresh rotation and Express guard integration",
  "author": "ExpressoTS Team",
  "main": "./lib/cjs/index.js",
  "types": "./lib/cjs/types/index.d.ts",
  "engines": {
    "node": ">=20.19.0"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./lib/esm/types/index.d.ts",
        "default": "./lib/esm/index.mjs"
      },
      "require": {
        "types": "./lib/cjs/types/index.d.ts",
        "default": "./lib/cjs/index.js"
      }
    }
  },
  "files": [
    "lib/**/*",
    "README.md",
    "LICENSE.md",
    "CHANGELOG.md",
    "SECURITY_REVIEW.md"
  ],
  "license": "MIT",
  "homepage": "https://expresso-ts.com",
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/expressots"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/expressots/expressots.git",
    "directory": "packages/jwt"
  },
  "bugs": {
    "url": "https://github.com/expressots/expressots/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "expressots",
    "nodejs",
    "microservices",
    "typescript",
    "clean-architecture",
    "typescript-framework",
    "framework",
    "server-side"
  ],
  "scripts": {
    "clean": "node scripts/rm.js lib",
    "copy": "node scripts/copy.js README.md CHANGELOG.md lib",
    "build": "npm run clean && npm run build:cjs && npm run build:esm && npm run copy",
    "build:cjs": "tsc -p tsconfig.cjs.json",
    "build:esm": "node scripts/build-esm.js",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand",
    "test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand --watch",
    "coverage": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand --coverage",
    "format": "prettier --write \"src/**/*.ts\" --cache",
    "lint": "eslint \"src/**/*.ts\"",
    "lint:fix": "eslint \"src/**/*.ts\" --fix",
    "test:install": "node test/install-smoke.mjs"
  },
  "devDependencies": {
    "@expressots/core": "workspace:*",
    "@types/jest": "^29.5.14",
    "@types/node": "20.19.43",
    "@typescript-eslint/eslint-plugin": "7.16.0",
    "@typescript-eslint/parser": "7.16.0",
    "eslint": "8.57.0",
    "eslint-config-prettier": "9.1.0",
    "jest": "29.7.0",
    "ts-jest": "29.4.12",
    "ts-node": "10.9.2",
    "typescript": "5.9.3",
    "@expressots/adapter-express": "workspace:*",
    "@types/express": "5.0.6",
    "@jest/globals": "29.7.0"
  },
  "peerDependencies": {
    "@expressots/core": "workspace:^",
    "@expressots/adapter-express": "workspace:^"
  },
  "type": "commonjs",
  "dependencies": {
    "jose": "^6.2.12"
  }
}
