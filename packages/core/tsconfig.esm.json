{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022"],
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": "src",
    "outDir": "lib/esm",
    // Declarations are emitted once by the CJS build (lib/cjs/types); the
    // trees are byte-identical, so build-esm.js copies them into
    // lib/esm/types (ESM scope) instead of running tsc's emit twice.
    "declaration": false
  }
}
